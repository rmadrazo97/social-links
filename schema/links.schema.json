{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rmadrazo97/social-links/schema/links.schema.json",
  "title": "social-links config",
  "description": "Everything shown on the page lives in links.yml. This schema validates it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "links"
  ],
  "properties": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Display name, set large at the top."
        },
        "handle": {
          "type": "string",
          "maxLength": 40,
          "description": "Short handle shown under the name, e.g. @ada."
        },
        "bio": {
          "type": "string",
          "maxLength": 280,
          "description": "One or two sentences. Plain text."
        },
        "avatar": {
          "type": "string",
          "description": "Path to an image in public/ (e.g. /avatar.jpg) or an https:// URL. Omit to show a monogram."
        },
        "location": {
          "type": "string",
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "maxLength": 80,
          "description": "Optional live line with a pulsing dot, e.g. 'Booking projects for March'."
        },
        "headline": {
          "type": "string",
          "maxLength": 90,
          "description": "maison: large uppercase line under the logo. Wrap 1–2 words in *asterisks* to set them in the script font, e.g. 'Creando una vida *bonita* alrededor del hogar'."
        },
        "logo": {
          "type": "string",
          "pattern": "^/.+\\.svg$",
          "description": "maison: monogram SVG in public/ (e.g. /monogram.svg), single-colour using fill=\"currentColor\". Replaces the visible name."
        },
        "wordmark": {
          "type": "string",
          "pattern": "^/.+\\.svg$",
          "description": "maison: optional name wordmark SVG in public/, shown under the logo."
        },
        "logoWidth": {
          "type": "integer",
          "minimum": 96,
          "maximum": 200,
          "default": 104,
          "description": "maison: logo width in px."
        },
        "emboss": {
          "type": "boolean",
          "default": true,
          "description": "maison: press the logo into the paper (true) or print it flat in ink (false)."
        }
      }
    },
    "socials": {
      "type": "array",
      "description": "Icon-only row under the bio. Keep it to 6 or fewer.",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "icon",
          "url"
        ],
        "properties": {
          "icon": {
            "type": "string",
            "description": "simple-icons slug (github, x, instagram, youtube, tiktok, bluesky, threads, mastodon, spotify, discord…) or one of: linkedin, mail, globe, link, rss, phone, calendar."
          },
          "url": {
            "$ref": "#/definitions/url"
          },
          "label": {
            "type": "string",
            "description": "Accessible name. Defaults to the platform name."
          }
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered list of link rows and section headings.",
      "items": {
        "if": {
          "type": "object",
          "required": [
            "section"
          ]
        },
        "then": {
          "$ref": "#/definitions/section"
        },
        "else": {
          "$ref": "#/definitions/link"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "enum": [
            "studio",
            "midnight",
            "bloom",
            "mono",
            "maison"
          ],
          "default": "studio"
        },
        "mode": {
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto",
          "description": "auto follows the visitor's system setting."
        },
        "accent": {
          "$ref": "#/definitions/hex",
          "description": "Override the preset accent color."
        },
        "radius": {
          "enum": [
            "sharp",
            "soft",
            "round"
          ],
          "description": "Override corner rounding."
        },
        "texture": {
          "enum": [
            "paper",
            "none"
          ],
          "default": "paper",
          "description": "maison: paper grain on the background."
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "description": "maison: override palette colours. ink on bg must reach 4.5:1.",
          "properties": {
            "bg": {
              "$ref": "#/definitions/hex"
            },
            "surface": {
              "$ref": "#/definitions/hex"
            },
            "surfaceHover": {
              "$ref": "#/definitions/hex"
            },
            "ink": {
              "$ref": "#/definitions/hex"
            },
            "soon": {
              "$ref": "#/definitions/hex"
            },
            "line": {
              "$ref": "#/definitions/hex"
            },
            "lineStrong": {
              "$ref": "#/definitions/hex"
            },
            "accent2": {
              "$ref": "#/definitions/hex"
            },
            "desk": {
              "$ref": "#/definitions/hex"
            },
            "embossFill": {
              "$ref": "#/definitions/hex"
            },
            "embossHi": {
              "$ref": "#/definitions/hex"
            },
            "embossLo": {
              "$ref": "#/definitions/hex"
            },
            "onAccent": {
              "$ref": "#/definitions/hex"
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 70,
          "description": "Browser tab + share title. Defaults to profile.name."
        },
        "description": {
          "type": "string",
          "maxLength": 200,
          "description": "Search/share description. Defaults to profile.bio."
        },
        "url": {
          "$ref": "#/definitions/url",
          "description": "Canonical public URL of this page."
        },
        "image": {
          "type": "string",
          "description": "Share image (1200×630) path in public/ or https:// URL."
        },
        "lang": {
          "type": "string",
          "default": "en"
        }
      }
    },
    "analytics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cloudflare_token": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$",
          "description": "Cloudflare Web Analytics beacon token (free, cookieless)."
        }
      }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "credit": {
          "type": "boolean",
          "default": true,
          "description": "Show the small 'made with social-links' credit."
        },
        "email": {
          "type": "string",
          "description": "maison: plain email shown in the footer.",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "copyright": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "description": "UI words, for other languages.",
      "properties": {
        "soon": {
          "type": "string"
        },
        "opens": {
          "type": "string"
        },
        "mail": {
          "type": "string"
        },
        "madeWith": {
          "type": "string"
        }
      }
    }
  },
  "definitions": {
    "url": {
      "type": "string",
      "pattern": "^(https?://|mailto:|tel:)",
      "description": "Must start with https://, http://, mailto: or tel:"
    },
    "hex": {
      "type": "string",
      "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "url": {
          "$ref": "#/definitions/url",
          "description": "Omit only together with soon: true."
        },
        "description": {
          "type": "string",
          "maxLength": 140,
          "description": "Optional second line."
        },
        "icon": {
          "type": "string",
          "description": "Optional icon slug, same names as socials."
        },
        "featured": {
          "type": "boolean",
          "description": "Render as the large accent card. Use on at most one link."
        },
        "hidden": {
          "type": "boolean",
          "description": "Keep in config but don't show."
        },
        "soon": {
          "type": "boolean",
          "description": "Coming soon. Without url it renders as a non-clickable row tagged 'Próximamente'/'Coming soon'."
        },
        "cta": {
          "type": "string",
          "maxLength": 40,
          "description": "maison featured card: action line, e.g. 'Avísame cuando salga'."
        },
        "eyebrow": {
          "type": "string",
          "maxLength": 30,
          "description": "maison featured card: small line above the title."
        }
      },
      "if": {
        "not": {
          "required": [
            "soon"
          ],
          "properties": {
            "soon": {
              "const": true
            }
          }
        }
      },
      "then": {
        "required": [
          "url"
        ]
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section"
      ],
      "properties": {
        "section": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Small heading that groups the links below it."
        }
      }
    }
  }
}
